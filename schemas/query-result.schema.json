{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nestra.dev/schemas/query-result.schema.json",
  "title": "NESTRA query result",
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "projectId",
    "route",
    "status",
    "answer",
    "verified",
    "router",
    "reasons",
    "evidence",
    "guard",
    "telemetry"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$" },
    "route": { "$ref": "#/$defs/route" },
    "status": { "enum": ["completed", "blocked", "needs_review"] },
    "answer": { "type": ["string", "null"] },
    "verified": { "type": "boolean" },
    "router": { "$ref": "#/$defs/router" },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "guard": { "type": ["object", "null"] },
    "telemetry": { "$ref": "#/$defs/telemetry" }
  },
  "$defs": {
    "route": { "enum": ["blocked", "retrieval", "micro", "meso", "full"] },
    "usage": {
      "type": "object",
      "required": ["inputTokens", "outputTokens", "reasoningTokens", "totalTokens", "cachedInputTokens"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "reasoningTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "cachedInputTokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "router": {
      "type": "object",
      "required": ["source", "deterministicRoute", "selectedRoute", "vetoReason"],
      "properties": {
        "source": { "enum": ["deterministic", "learned"] },
        "deterministicRoute": { "$ref": "#/$defs/route" },
        "selectedRoute": { "$ref": "#/$defs/route" },
        "modelId": { "type": ["string", "null"] },
        "microSafeProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "thresholds": { "type": "object", "additionalProperties": { "type": "number" } },
        "featureSchemaVersion": { "type": "integer", "minimum": 1 },
        "vetoReason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["projectId", "documentId", "title", "contentHash", "sentenceIndex", "sourceUri"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "documentId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 },
        "sentenceIndex": { "type": "integer", "minimum": 0 },
        "sourceUri": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "title", "text", "documentId", "sourceUri", "retrievalScore", "provenance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "documentId": { "type": "string", "minLength": 1 },
        "sourceUri": { "type": ["string", "null"] },
        "retrievalScore": { "type": "number" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "required": ["route", "provider", "model", "latencyMs", "usage"],
      "properties": {
        "route": { "$ref": "#/$defs/route" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "latencyMs": { "type": "number", "minimum": 0 },
        "usage": { "$ref": "#/$defs/usage" }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "required": ["attemptedRoutes", "modelCalls", "calls", "usage", "latencyMs", "alerts"],
      "properties": {
        "attemptedRoutes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
        "modelCalls": { "type": "integer", "minimum": 0 },
        "calls": { "type": "array", "items": { "$ref": "#/$defs/call" } },
        "usage": { "$ref": "#/$defs/usage" },
        "latencyMs": { "type": "number", "minimum": 0 },
        "alerts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
