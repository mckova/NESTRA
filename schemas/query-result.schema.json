{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nestra.dev/schemas/query-result.schema.json",
  "title": "NESTRA query result",
  "type": "object",
  "required": ["schemaVersion", "requestId", "projectId", "route", "status", "verified", "router", "evidence", "telemetry"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string" },
    "projectId": { "type": "string" },
    "route": { "enum": ["blocked", "retrieval", "micro", "meso", "full"] },
    "status": { "enum": ["completed", "blocked", "needs_review"] },
    "answer": { "type": ["string", "null"] },
    "verified": { "type": "boolean" },
    "router": {
      "type": "object",
      "required": ["source", "deterministicRoute", "selectedRoute"],
      "properties": {
        "source": { "enum": ["deterministic", "learned"] },
        "deterministicRoute": { "enum": ["blocked", "retrieval", "micro", "meso", "full"] },
        "selectedRoute": { "enum": ["blocked", "retrieval", "micro", "meso", "full"] },
        "modelId": { "type": ["string", "null"] },
        "microSafeProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "vetoReason": { "type": ["string", "null"] }
      }
    },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "guard": { "type": ["object", "null"] },
    "telemetry": {
      "type": "object",
      "required": ["attemptedRoutes", "modelCalls", "usage", "latencyMs", "alerts"],
      "properties": {
        "attemptedRoutes": { "type": "array", "items": { "type": "string" } },
        "modelCalls": { "type": "integer", "minimum": 0 },
        "usage": {
          "type": "object",
          "required": ["inputTokens", "outputTokens", "reasoningTokens", "totalTokens", "cachedInputTokens"]
        },
        "latencyMs": { "type": "number", "minimum": 0 },
        "alerts": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "additionalProperties": false
}
