{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nestra.dev/schemas/project-input.schema.json",
  "title": "NESTRA project input",
  "type": "object",
  "required": ["projectId", "documents"],
  "properties": {
    "projectId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title"],
        "anyOf": [
          { "required": ["text"] },
          { "required": ["sentences"] }
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "sentences": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceUri": { "type": ["string", "null"] },
          "trust": { "enum": ["trusted", "untrusted"] },
          "sensitivity": { "type": "number", "minimum": 0, "maximum": 1 },
          "sourceQuality": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
