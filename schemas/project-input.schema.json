{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nestra.dev/schemas/project-input.schema.json",
  "title": "NESTRA project input",
  "type": "object",
  "required": ["projectId", "documents"],
  "properties": {
    "projectId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "text"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "sourceUri": { "type": ["string", "null"] },
          "trust": { "enum": ["trusted", "untrusted"] },
          "sensitivity": { "type": "number", "minimum": 0, "maximum": 1 },
          "sourceQuality": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
